            oracle_num <- which.min(df$card_diff)
            BIC_num <- which.min(df$BIC)
          })[3]

          Lambda_oracle <- ifelse(result_list[[oracle_num]]$A==0,0,1)
          Lambda_BIC <- ifelse(result_list[[BIC_num]]$A==0,0,1)

          time_refit_BIC <- system.time({
            result_BIC <- GPCM_CHiMIRT(Y,result_list[[BIC_num]],Lambda_BIC,K,
                                        orthogonal=orthogonal,Z_output=F,
                                        max_iter=2000,tol=tol)
          })[3]
          vec_BIC <- calResults(result_BIC,Data,N,J,K,C,model="GPCM")

          vec_oracle <- calResults(result_list[[oracle_num]],
                                   Data,N,J,K,C,model="GPCM")

          time_seq <- system.time({
            result_seq <- GPCM_card_HiMIRT(Y,K,C,Params=result_BIC,
                                          random_start=F,
                                          kappaC=sum(Lambda_BIC!=0),
                                          orthogonal=orthogonal, tol=1e-5,
                                          max_iter=200)

            # iterative thresholding: drop nonzero loadings below .3,
            # refit with the reduced cardinality, repeat
            repeat {
              small_num <- sum(abs(result_seq$A)<.3 & result_seq$A!=0)
              kappaC_new <- sum(result_seq$A!=0)-small_num
              if (small_num==0 || kappaC_new<K) break
              result_seq <- GPCM_card_HiMIRT(Y,K,C,Params=result_seq,
                                            random_start=F,
                                            kappaC=kappaC_new,
                                            orthogonal=orthogonal, tol=1e-5,
                                            max_iter=200)
            }
          })[3]

          vec_seq <- calResults(result_seq,Data,N,J,K,C,model="GPCM")

          simu_res <- as.data.frame(rbind(vec_rot, vec_oracle, vec_BIC, vec_seq))
          simu_res$J <- J
          simu_res$sample_coef <- sample_coef
          simu_res$K <- K
          simu_res$rho <- rho_value
          simu_res$method <- c("rotation","lasso_oracle",
                               "lasso_BIC","Seq_ITC")
          pipe_common <- time_init+time_lasso
          simu_res$time <- c(time_rot,
                             pipe_common,
                             pipe_common+time_refit_BIC,
                             pipe_common+time_refit_BIC+time_seq)

          cat(sprintf("%s  J=%d K=%d tau= %.1f rho=%s  rep %d done\n",
                      format(Sys.time(), "%H:%M:%S"), J, K, sample_coef, rho_value, i),
              file = prog_file, append = TRUE)

          return(simu_res)
        })

        res <- as.data.frame(do.call(rbind, df_ls))
        GPCM_simu_result <- rbind(GPCM_simu_result,res)
        
        print(sprintf("J= %d tau= %.1f K= %d rho=%s  finished",
                      J, sample_coef, K, rho_value))
      }
    }
  }
}

