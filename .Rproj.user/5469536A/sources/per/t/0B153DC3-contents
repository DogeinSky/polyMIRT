```{r}
rotation_result <- data.frame(J = integer(), sample_coef = integer(), K = integer(), rho = character(),
                              prob_diff = numeric(), tau_diff = numeric(), Theta_diff = numeric(),
                              sens=numeric(), spec=numeric(), load_diff = numeric(), rho_diff = numeric(),
                              method=character())

cl <- makeCluster(5)
clusterSetRNGStream(cl, 2026)   # independent worker RNG streams

# workers append one line per finished replicate; watch live with
#   tail -f GRM_sim_progress.log   (in Terminal, from the Simulation folder)
prog_file <- file.path(getwd(), "GRM_sim_progress.log")
unlink(prog_file)

clusterEvalQ(cl, {
  Sys.setenv(
    VECLIB_MAXIMUM_THREADS = "1",
    OPENBLAS_NUM_THREADS   = "1",
    MKL_NUM_THREADS        = "1",
    OMP_NUM_THREADS        = "1"
  )

  library(MASS)
  library(clue)
  library(GPArotation)
  
  setwd("/Users/travisyang/PhD/Repos_work/Poly_MIRT")
  library(Rcpp)
  sourceCpp("R/poly_mirt_rcpp.cpp")

  NULL
})
funcs <- ls(envir = .GlobalEnv)
funcs <- funcs[sapply(funcs, function(f) is.function(get(f)))]
# Rcpp-compiled functions must NOT be exported. Their bodies are
# .Call(<pointer: 0x..>, ..) and the pointer is NULL in another process, so
# exporting them clobbers the copies sourceCpp() just built on the worker and
# the next call fails with "NULL value passed as symbol address".
rcpp_exports <- c("compute_PFf","tau_stats_grm","compute_H_gpcm","compute_H_grm",
                  "compute_Z_grm_cpp","init_M_tilde","logl_grm","logl_gpcm")
funcs <- setdiff(funcs, rcpp_exports)
funcs <- c(funcs, "mvrnorm","solve_LSAP","GPFoblq")
clusterExport(cl, funcs)

for (J in J_values){
  for (sample_coef in sample_values){
    for (K in K_values){
      for (rho_value in rho_set){
        A_true <- generate_A(J,K,zero_prob=0.7)
        tau_true <- generate_tau(J,C)
        rho <- switch(
            rho_value,
            orth = 0,
            low  = c(0.1, 0.3),
            high = c(0.4, 0.6)
          )
        # draw the pairwise correlations ONCE per cell, so all nSim
        # replicates share the same true correlation matrix
        if (length(rho) == 2) {
          rho <- runif(K*(K-1)/2, rho[1], rho[2])
        }
        clusterExport(cl, varlist=c("J", "C","sample_coef", "K","A_true","tau_true", "rho_value","rho","prog_file"))
        
        df_ls <- parLapplyLB(cl, 1:nSim, function(i){
          N=sample_coef*J

          Data <- generate_data(N,J,rho=rho,A_true,model="GRM",C=C,tau_true=tau_true)
          Y <- Data$Y
          
          result <- GRM_HiMMIRT(Y,K,C,alpha=1,rotation=T,max_iter=200,tol=1e-5)

          # Rotation baseline. The threshold is fixed without reference to the
          # truth, so this is the honest counterpart to choosing a lambda; the
          # refit then uses the same masked machinery as lasso_BIC / Seq_ITC,
          # leaving the selection rule as the only difference.
          res_thr   <- result
          res_thr$A <- ifelse(abs(result$A) < 0.3, 0, result$A)
          vec_thr   <- calResults(res_thr, Data, N, J, K, C, model = "GRM")[1:7]

          Lambda_rot <- ifelse(res_thr$A == 0, 0, 1)
          res_refit  <- GRM_CHiMIRT(Y, result, Lambda_rot, K,
                                    orthogonal = T,
                                    max_iter = 2000, tol = 1e-5)
          vec_refit  <- calResults(res_refit, Data, N, J, K, C, model = "GRM")[1:7]

          out <- as.data.frame(rbind(vec_thr, vec_refit))
          rownames(out) <- NULL
          out$method <- c("rot_thr", "rot_refit")

          cat(sprintf("J=%d sc=%d K=%d rho=%s rep=%d  %s\n",
                      J, sample_coef, K, rho_value, i,
                      format(Sys.time(), "%H:%M:%S")),
              file = prog_file, append = TRUE)

          out
        })

        df_cell <- do.call(rbind, df_ls)
        df_cell$J           <- J
        df_cell$sample_coef <- sample_coef
        df_cell$K           <- K
        df_cell$rho         <- rho_value

        rotation_result <- rbind(rotation_result,
                                 df_cell[, names(rotation_result)])
      }
    }
  }
}

stopCluster(cl)
saveRDS(rotation_result, "GRM_rotation_result.rds")

aggregate(cbind(prob_diff, load_diff, sens, spec) ~ method,
          data = rotation_result, FUN = mean)

