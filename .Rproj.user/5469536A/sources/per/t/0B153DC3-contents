med <- function(x) median(x, na.rm = TRUE)   # NA rows must not blank a median

panel <- function(df, metric, ylab, ylim = NULL) {
  ggplot(df, aes(factor(J), .data[[metric]], colour = method)) +
    geom_hline(yintercept = 1, linetype = 3, colour = "grey65") +
    geom_point(position = position_jitterdodge(jitter.width = 0.18,
                                               dodge.width = 0.6),
               alpha = 0.15, size = 0.7, show.legend = FALSE) +
    stat_summary(fun = med, geom = "line", aes(group = method),
                 position = position_dodge(0.6), linewidth = 0.5) +
    stat_summary(fun = med, geom = "point", size = 2,
                 position = position_dodge(0.6)) +
    facet_grid(rho ~ sample_coef + K, labeller = label_both) +
    coord_cartesian(ylim = ylim) +
    labs(x = "J", y = ylab) +
    guides(colour = guide_legend(ncol = 1,
                                 override.aes = list(alpha = 1, size = 2.2))) +
    theme_bw(base_size = 9) +
    theme(legend.position     = "right",
          legend.direction    = "vertical",
          legend.key.size     = unit(9, "pt"),
          legend.title        = element_text(size = 8),
          legend.text         = element_text(size = 7),
          legend.margin       = margin(0, 0, 0, 0),
          legend.box.spacing  = unit(3, "pt"),
          panel.spacing       = unit(2, "pt"))
}

