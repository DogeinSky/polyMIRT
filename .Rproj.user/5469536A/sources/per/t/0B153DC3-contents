GRM_simu_result <- data.frame(J = integer(), sample_coef = integer(), K = integer(), rho = character(), method=character(),
                              prob_diff = numeric(), tau_diff = numeric(), Theta_diff = numeric(),
                              sens=numeric(), spec=numeric(), load_diff = numeric(), card_diff = numeric(), rho_diff = numeric(),
