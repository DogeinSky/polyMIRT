cl <- makeCluster(6)
clusterSetRNGStream(cl, 2026)   # independent worker RNG streams

# workers append one line per finished replicate; watch live with
#   tail -f GRM_sim_progress.log   (in Terminal, from the Simulation folder)
prog_file <- file.path(getwd(), "GRM_sim_progress.log")
unlink(prog_file)

clusterEvalQ(cl, {
  Sys.setenv(
    VECLIB_MAXIMUM_THREADS = "1",
    OPENBLAS_NUM_THREADS   = "1",
    MKL_NUM_THREADS        = "1",
    OMP_NUM_THREADS        = "1"
  )

  library(MASS)
  library(clue)
  library(GPArotation)
  
  setwd("/Users/travisyang/PhD/Repos_work/Poly_MIRT")
  library(Rcpp)
  sourceCpp("R/poly_mirt_rcpp.cpp")

  NULL
})
funcs <- ls(envir = .GlobalEnv)
funcs <- funcs[sapply(funcs, function(f) is.function(get(f)))]
# Rcpp-compiled functions must NOT be exported. Their bodies are
# .Call(<pointer: 0x..>, ..) and the pointer is NULL in another process, so
# exporting them clobbers the copies sourceCpp() just built on the worker and
# the next call fails with "NULL value passed as symbol address".
rcpp_exports <- c("compute_PFf","tau_stats_grm","compute_H_gpcm","compute_H_grm",
                  "compute_Z_grm_cpp","init_M_tilde","logl_grm","logl_gpcm")
funcs <- setdiff(funcs, rcpp_exports)
funcs <- c(funcs, "mvrnorm","solve_LSAP","GPFoblq")
clusterExport(cl, funcs)

for (J in J_values){
  for (sample_coef in sample_values){
    for (K in K_values){
      for (rho_value in rho_set){
        A_true <- generate_A(J,K,zero_prob=0.8)
        tau_true <- generate_tau(J,C)
        rho <- switch(
            rho_value,
            orth = 0,
            low  = c(0.1, 0.4),
            high = c(0.4, 0.6)
          )
        # draw the pairwise correlations ONCE per cell, so all nSim
        # replicates share the same true correlation matrix
        if (length(rho) == 2) {
          rho <- runif(K*(K-1)/2, rho[1], rho[2])
        }
        clusterExport(cl, varlist=c("J", "C","sample_coef", "K","A_true","tau_true", "rho_value","rho","prog_file"))
        
        df_ls <- parLapplyLB(cl, 1:nSim, function(i){
          N=sample_coef*J

          Data <- generate_data(N,J,rho=rho,A_true,model="GRM",C=C,tau_true=tau_true)
          Y <- Data$Y
          
          orthogonal <- ifelse(rho_value=="orth", TRUE, FALSE)
          
          time_rot <- system.time({
            result_rot <- GRM_HiMMIRT(Y,K,C,alpha=1,rotation=T,max_iter=2000,tol=1e-5)
          
            result_rot$A <- ifelse(abs(result_rot$A) < 0.3, 0, result_rot$A)
            Lambda_rot <- ifelse(result_rot$A == 0, 0, 1)
            
            result_rot_refit  <- GRM_CHiMIRT(Y, result_rot, Lambda_rot, K,
                                             orthogonal = orthogonal,
                                      max_iter = 2000, tol = 1e-5)
          })[3]
          
          vec_rot  <- calResults(result_rot_refit, Data, N, J, K, C, model = "GRM")
          
          lambda_max <- ifelse(sample_coef==10,J*2,J*3)
          if (rho_value == "high") {
            lambda_max <-ifelse(sample_coef==10,lambda_max, lambda_max*1.5)
          }

          # shared warm start (used by card, autolasso, and the refits)
          time_init <- system.time({
            Params <- GRM_HiMMIRT(Y,K,C,alpha=1,rotation=T,max_iter=200,tol=1e-3)
          })[3]

          time_lasso <- system.time({
            result_list <- GRM_autolasso_HiMIRT(Y,K,C,Params=Params,try_out=15,
                                                lambda_range=c(0,lambda_max),
                                                orthogonal=orthogonal)
            # only card_diff and BIC are used to pick a lambda; calSelect()
            # returns exactly those, skipping ref.perp() and the two
            # N x J x C probability arrays calResults() would build per call
            df <- as.data.frame(t(sapply(1:(length(result_list)-1),
                        function(i) calSelect(result_list[[i]], Data, N, K))))

            oracle_num <- which.min(df$card_diff)
            BIC_num <- which.min(df$BIC)
          })[3]

          Lambda_oracle <- ifelse(result_list[[oracle_num]]$A==0,0,1)
          Lambda_BIC <- ifelse(result_list[[BIC_num]]$A==0,0,1)

          time_refit_BIC <- system.time({
            result_BIC <- GRM_CHiMIRT(Y,Params,Lambda_BIC,K,
                                      orthogonal=orthogonal,
                                      max_iter=200,tol=1e-5)
          })[3]
          vec_BIC <- calResults(result_BIC,Data,N,J,K,C,model="GRM")

          if (identical(Lambda_oracle,Lambda_BIC)){
            time_refit_oracle <- time_refit_BIC   # same refit serves both
            vec_oracle <- vec_BIC
          } else {
            time_refit_oracle <- system.time({
              result_oracle <- GRM_CHiMIRT(Y,Params,Lambda_oracle,K,
                                          orthogonal=orthogonal,
                                          max_iter=200,tol=1e-5)
            })[3]
            vec_oracle <- calResults(result_oracle,Data,N,J,K,C,model="GRM")
          }


          time_seq <- system.time({
            result_seq <- GRM_card_HiMIRT(Y,K,C,Params=result_BIC,
                                        random_start=F,
                                        kappaC=sum(Lambda_BIC!=0),
                                        orthogonal=orthogonal, tol=1e-5,
                                        alpha=1,max_iter=200)

            # iterative thresholding: drop nonzero loadings below .3,
            # refit with the reduced cardinality, repeat
            repeat {
              small_num <- sum(abs(result_seq$A)<.3 & result_seq$A!=0)
              kappaC_new <- sum(result_seq$A!=0)-small_num
              if (small_num==0 || kappaC_new<K) break
              result_seq <- GRM_card_HiMIRT(Y,K,C,Params=result_seq,
                                          random_start=F,
                                          kappaC=kappaC_new,
                                          orthogonal=orthogonal, tol=1e-5,
                                          alpha=1,max_iter=200)
            }
          })[3]

          vec_seq <- calResults(result_seq,Data,N,J,K,C,model="GRM")

          simu_res <- as.data.frame(rbind(vec_rot, vec_oracle, 
                                          vec_BIC, vec_seq))
          simu_res$J <- J
          simu_res$sample_coef <- sample_coef
          simu_res$K <- K
          simu_res$rho <- rho_value
          simu_res$method <- c("rotation","lasso_oracle",
                               "lasso_BIC","Seq_ITC")
          pipe_common <- time_init+time_lasso
          simu_res$time <- c(time_rot,
                             pipe_common+time_refit_oracle,
                             pipe_common+time_refit_BIC,
                             pipe_common+time_refit_BIC+time_seq)

          cat(sprintf("%s  J=%d K=%d rho=%s  rep %d done\n",
                      format(Sys.time(), "%H:%M:%S"), J, K, rho_value, i),
              file = prog_file, append = TRUE)

          return(simu_res)
        })

        res <- as.data.frame(do.call(rbind, df_ls))
        GRM_simu_result <- rbind(GRM_simu_result,res)
        
        print(sprintf("J= %d tau= %.1f K= %d rho=%s  finished",
                      J, sample_coef, K, rho_value))
      }
    }
  }
}

